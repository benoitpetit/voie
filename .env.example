# Copy this file to .env and change only the values you need.

# HTTP bind address and port.
HOST=127.0.0.1
PORT=8080

# Set to true for debug logs.
DEBUG=false

# Optional provider for generic "openai" requests. Supported values:
# perplexity, duckai, deepai, quillbot, yqcloud, cohere, jimmy
DEFAULT_PROVIDER=

# End-to-end request timeout in seconds.
TIMEOUT=120

# Optional model used to classify requests when automatic routing is ambiguous.
ROUTER_MODEL=
# Optional ensemble synthesizer; falls back to ROUTER_MODEL.
SYNTHESIS_MODEL=
# Local JSON model/task routing policy.
ROUTING_CONFIG_PATH=
# Local SQLite conversation database. Created lazily when conversation features are used.
CONVERSATION_DB_PATH=
# Conversation inactivity lifetime (Go duration syntax).
CONVERSATION_TTL=720h

# Global fallback policy defaults. Each supports 0 to 3.
# Set false to disable provider fallback entirely.
FALLBACK_ENABLED=true
# Tries the same model again on a transient failure.
FALLBACK_MAX_RETRIES=1
# Maximum number of extra models tried before giving up.
FALLBACK_MAX_MODELS=1
# Per-model fallback lists live in routing.json under the "fallback" key
# and override these environment values.

# Required when HOST is not a loopback address.
API_TOKEN=
